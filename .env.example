# Copy to .env and fill in. Never commit .env.

# --- Ingestion (optional) ---
# A Socrata app token raises throttling limits. Create one at
# https://data.cityofnewyork.us/profile/edit/developer_settings
CIVICPULSE_SOCRATA_APP_TOKEN=

# --- Storage ---
CIVICPULSE_DATA_DIR=./data

# --- API ---
CIVICPULSE_API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CIVICPULSE_API_RATE_LIMIT_PER_MINUTE=600
# Set to the number of edge proxies that append X-Forwarded-For (0 = ignore the header).
CIVICPULSE_API_TRUSTED_PROXY_HOPS=0
CIVICPULSE_LOG_LEVEL=INFO

# --- Web (server-side only; the browser talks to the API through Next.js rewrites) ---
API_BASE_URL=http://127.0.0.1:8000

# --- AI analyst (Milestone 3). Server-side only: never prefix with NEXT_PUBLIC_. ---
# fake = deterministic test provider (default, no network, not an LLM); openai = OpenAI-compatible API; disabled.
CIVICPULSE_LLM_PROVIDER=fake
CIVICPULSE_LLM_MODEL=deterministic-fake-v1
# Placeholder only. Real keys belong in your local .env or a secret manager, never in Git.
CIVICPULSE_OPENAI_API_KEY=
CIVICPULSE_OPENAI_BASE_URL=https://api.openai.com/v1
CIVICPULSE_AI_MAX_TOOL_CALLS=6
CIVICPULSE_AI_MAX_OUTPUT_TOKENS=900
CIVICPULSE_AI_MAX_INPUT_TOKENS=24000
CIVICPULSE_AI_REQUEST_TIMEOUT=60
CIVICPULSE_AI_MAX_REGENERATIONS=1
# Global USD ceiling per UTC day; set the prices below to your provider's per-1M-token prices to enforce it.
CIVICPULSE_AI_DAILY_BUDGET=1.00
CIVICPULSE_AI_PRICE_INPUT_PER_MTOK=0
CIVICPULSE_AI_PRICE_OUTPUT_PER_MTOK=0
CIVICPULSE_AI_RATE_LIMIT_PER_MINUTE=6
CIVICPULSE_AI_DAILY_REQUEST_LIMIT=500
CIVICPULSE_AI_MAX_QUESTION_CHARS=500
# Optional shared secret for POST /api/v1/ai/investigations. Required for any public deployment.
CIVICPULSE_AI_ACCESS_TOKEN=

# --- MCP server ---
# stdio (default): the API spawns `python -m civicpulse_mcp` per investigation; nothing listens on the network.
CIVICPULSE_MCP_TRANSPORT=stdio
# Only for --transport streamable-http (loopback by default; token of 32+ characters required):
# CIVICPULSE_MCP_URL=http://127.0.0.1:8765/mcp
# CIVICPULSE_MCP_HTTP_TOKEN=
# CIVICPULSE_MCP_AUDIT_LOG=
